# Exact revisions used by the CAD repository.
# SCPF and SCPC are installed as Python libraries locally by bootstrap.ps1.
# CAD CI checks out their exact sources and mounts them into the released
# central SolidCraft runtime without building an image or pip-installing them.
# tool.cad.ci is checked out and installed on the host for publication.
# The central runtime is independent from these consumer dependency pins.
repositories:
  scpf:
    type: git
    url: https://github.com/brainboxemb/lib.py.solidcraft.forge.git
    version: 9258d54079981604b6dd777a4c4face897c190fe
  scpc:
    type: git
    url: https://github.com/brainboxemb/lib.py.solidcraft.cmd.git
    version: fcaa6f9fc8388bc715fcd2fbb149ce6b979566a7
  cad-ci:
    type: git
    url: https://github.com/brainboxemb/tool.cad.ci.git
    version: 556e8d43dde9218b28a8d991ab9f2021232e76ab
