{{/*
Direct model.yml -> Hugo page adapter.

This code creates routes and attaches existing resources. It never executes
CAD, selects CI items, or infers successful build/verification evidence.

AddResource receives source .Content rather than the source Resource object.
That is deliberate: Hugo then creates a new page resource at the declared
logical path. Passing the existing Resource object keeps its global publication
identity and does not produce /models/<slug>/<resource>.
*/}}
{{ $catalog := hugo.Data.cad.models }}
{{ $categoryTitles := dict
  "basic" "Basic Models"
  "components" "Components"
  "advanced" "Advanced Models"
}}

{{ range $section := slice "basic" "components" "advanced" }}
  {{ $.AddPage (dict
    "kind" "page"
    "path" $section
    "title" (index $categoryTitles $section)
    "params" (dict "categoryIndex" true "cadSection" $section)
  ) }}
{{ end }}

{{ range $section, $roots := $catalog }}
  {{ range $rootName, $rootData := $roots }}
    {{ with $meta := index $rootData "model" }}
      {{ $entries := slice }}
      {{ with $variants := index $meta "variants" }}
        {{ range $slug, $variant := $variants }}
          {{ $entries = $entries | append (dict "slug" $slug "model" $variant) }}
        {{ end }}
      {{ else }}
        {{ $slug := strings.Replace $rootName "_" "-" }}
        {{ $entries = $entries | append (dict "slug" $slug "model" $meta) }}
      {{ end }}

      {{ range $entry := $entries }}
        {{ $slug := index $entry "slug" }}
        {{ $model := index $entry "model" }}
        {{ $buildRoot := printf "build/models/%s/%s/models/%s" $section $rootName $slug }}
        {{ $provenance := dict }}
        {{ with resources.Get (printf "%s/provenance.json" $buildRoot) }}
          {{ $provenance = . | transform.Unmarshal }}
        {{ end }}

        {{ $.AddPage (dict
          "content" (dict "mediaType" "text/markdown" "value" (index $model "description"))
          "kind" "page"
          "path" $slug
          "title" (index $model "title")
          "params" (dict
            "model" $model
            "cadSection" $section
            "cadRoot" $rootName
            "cadSlug" $slug
            "buildProvenance" $provenance
          )
        ) }}

        {{ with resources.Get (printf "cad-source/%s/%s/model.yml" $section $rootName) }}
          {{ $.AddResource (dict
            "content" (dict "mediaType" .MediaType.Type "value" .Content)
            "path" (printf "%s/model.yml" $slug)
          ) }}
        {{ end }}

        {{/* Show the exact SCPF source declared by this model. */}}
        {{ $sourcePath := index $model "source" }}
        {{ with resources.Get (printf "cad-source/%s/%s/%s" $section $rootName $sourcePath) }}
          {{ $.AddResource (dict
            "content" (dict "mediaType" "text/plain" "value" .Content)
            "path" (printf "%s/scpf-source.py" $slug)
          ) }}
        {{ end }}

        {{ with resources.Get (printf "%s/model.png" $buildRoot) }}
          {{ $.AddResource (dict
            "content" (dict "mediaType" .MediaType.Type "value" .Content)
            "path" (printf "%s/model.png" $slug)
          ) }}
        {{ end }}

        {{/* Keep downloadable native outputs in the page bundle too.
             This makes their public path deterministic and avoids relying on
             resources.Copy side effects inside the presentation template. */}}
        {{ range $resource := slice
          (dict "source" (printf "%s/native/model.sc" $buildRoot) "target" "model.sc")
          (dict "source" (printf "%s/native/model.step" $buildRoot) "target" "model.step")
        }}
          {{ with resources.Get (index $resource "source") }}
            {{/* .sc is a SolidCraft binary container, not Scala source.
                 Keep native downloads opaque so Hugo never interprets their
                 extension as a text/source media type. */}}
            {{ $.AddResource (dict
              "content" (dict "mediaType" "application/octet-stream" "value" .Content)
              "path" (printf "%s/%s" $slug (index $resource "target"))
            ) }}
          {{ end }}
        {{ end }}

        {{ range $resource := slice
          (dict "source" (printf "%s/provenance.json" $buildRoot) "target" "provenance.json")
          (dict "source" (printf "build/models/%s/%s/generated/%s/scpf/solidcraft.json" $section $rootName $slug) "target" "solidcraft.json")
          (dict "source" (printf "build/models/%s/%s/generated/%s/scpc/solidcraft.json" $section $rootName $slug) "target" "scpc-solidcraft.json")
        }}
          {{ with resources.Get (index $resource "source") }}
            {{ $.AddResource (dict
              "content" (dict "mediaType" .MediaType.Type "value" .Content)
              "path" (printf "%s/%s" $slug (index $resource "target"))
            ) }}
          {{ end }}
        {{ end }}

        {{ with $views := index $model "extra_views" }}
          {{ range $view := index $views "items" }}
            {{ $kind := index $view "kind" }}
            {{ $name := index $view "src" }}
            {{ if eq $kind "asset" }}
              {{ with resources.Get (printf "cad-source/%s/%s/%s" $section $rootName $name) }}
                {{ $.AddResource (dict
                  "content" (dict "mediaType" .MediaType.Type "value" .Content)
                  "path" (printf "%s/%s" $slug $name)
                ) }}
              {{ end }}
            {{ else if eq $kind "build" }}
              {{ with resources.Get (printf "%s/native/%s" $buildRoot $name) }}
                {{ $.AddResource (dict
                  "content" (dict "mediaType" .MediaType.Type "value" .Content)
                  "path" (printf "%s/%s" $slug $name)
                ) }}
              {{ end }}
            {{ end }}
          {{ end }}
        {{ end }}
      {{ end }}
    {{ end }}
  {{ end }}
{{ end }}
